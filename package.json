{
  "name": "agentsol",
  "version": "0.2.0-alpha.4",
  "private": true,
  "description": "Local-first engine and MCP server for auditing AI agent instruction files (AGENTS.md, CLAUDE.md, SKILL.md) with your own assistant, with human-only approval before any file change.",
  "mcpName": "io.github.ArSenic04/agentsol",
  "type": "module",
  "bin": {
    "agentsol": "bin/agentsol.mjs",
    "agentsol-mcp": "bin/agentsol-mcp.mjs"
  },
  "files": [
    "bin/agentsol.mjs",
    "bin/agentsol-mcp.mjs",
    "build/**/*.js"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "cli": "node src/cli/main.ts",
    "mcp": "node src/mcp/main.ts",
    "demo": "node scripts/demo.ts",
    "doctor": "node scripts/doctor.mjs doctor",
    "web:build": "node scripts/buildWeb.ts",
    "web:preview": "node src/web/main.ts --static-only",
    "web:local": "node src/web/main.ts",
    "web:dev": "node scripts/buildWeb.ts && node src/web/main.ts --static-only",
    "test:web": "node scripts/buildWeb.ts && node --test --test-concurrency=1 \"tests/e2e/**/*.e2e.ts\"",
    "check:web": "npm run check && npm run test:web",
    "build": "node scripts/buildPackage.ts",
    "prepack": "node scripts/buildPackage.ts",
    "pack:check": "node scripts/packCheck.ts",
    "install:check": "node scripts/installCheck.ts",
    "load:test": "node scripts/loadTest.ts",
    "eval:learn": "node scripts/evalLearn.ts",
    "release:check": "node scripts/releaseCheck.ts",
    "pages:export": "node scripts/exportPages.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "tag": "alpha",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "agents-md",
    "claude-md",
    "skill-md",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "instructions",
    "audit"
  ]
}
